# AEGIS backend configuration.
#
# Copy to .env for local development. .env is gitignored and must never be
# committed. In deployments, set these as environment variables instead.
# Without configuration the backend runs as production with debug off and
# API documentation disabled.

# development | test | production
AEGIS_ENVIRONMENT=development

# Framework debug mode. Rejected when AEGIS_ENVIRONMENT=production.
# When enabled, unexpected errors return tracebacks to the client.
AEGIS_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
AEGIS_LOG_LEVEL=INFO

# json (structured, for log collection) | text (readable, for local use)
AEGIS_LOG_FORMAT=text

# Serve Swagger UI at /api/docs and the schema at /api/openapi.json.
# Leave unset for the default: enabled outside production, disabled in production.
# AEGIS_API_DOCS_ENABLED=true

# Largest accepted request body, in bytes (default 1048576 = 1 MiB).
# AEGIS_MAX_REQUEST_BODY_BYTES=1048576

# --- PostgreSQL --------------------------------------------------------------
# Leave AEGIS_DATABASE_HOST unset to run without a database (database-backed
# endpoints then return 503). The connection URL is built from these values;
# never configure or log it as a single string.
AEGIS_DATABASE_HOST=localhost
AEGIS_DATABASE_PORT=5432
AEGIS_DATABASE_NAME=aegis
AEGIS_DATABASE_USER=aegis
# No default. Required when AEGIS_ENVIRONMENT=production.
AEGIS_DATABASE_PASSWORD=
# disable | prefer | require | verify-ca | verify-full
# Use verify-full when the database is reached over an untrusted network.
AEGIS_DATABASE_SSLMODE=prefer
# Seconds to wait for a new connection.
# AEGIS_DATABASE_CONNECT_TIMEOUT=5
# Connection pool: persistent connections, extra connections under load,
# seconds to wait for a free connection, seconds before a connection is replaced.
# AEGIS_DATABASE_POOL_SIZE=5
# AEGIS_DATABASE_MAX_OVERFLOW=10
# AEGIS_DATABASE_POOL_TIMEOUT=30
# AEGIS_DATABASE_POOL_RECYCLE=1800

# --- Tests only ----------------------------------------------------------------
# Directory with PostgreSQL's initdb and pg_ctl, if they are not on PATH or in
# the standard Windows location. Tests create their own throwaway cluster.
# AEGIS_TEST_POSTGRES_BIN=
