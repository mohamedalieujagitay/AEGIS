# AEGIS .gitignore
#
# Directory patterns are either anchored to a known location (leading "/")
# or are tool-specific names, so they cannot hide legitimate source
# directories such as apps/frontend/src/lib/.

# ---------------------------------------------------------------------------
# Environment files and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# Package index credentials
.pypirc

# Private keys, keystores and generated secrets
*.pem
*.key
*.p12
*.pfx
*.jks
*_ed25519
# Docker Compose secret files and Valkey ACL file, generated by
# infrastructure/scripts/init_dev_secrets.py (DECISIONS.md D-053)
/secrets/
*.acl
# Docker Compose overrides with local settings
docker-compose.override.yml
compose.override.yaml

# No exceptions: test certificates and keys are generated at test run time
# and are never committed, including inside test fixture directories.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
.eggs/
/apps/*/build/
/apps/*/dist/
/build/
/dist/

# Python tooling caches and reports
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.import_linter_cache/

# Celery
celerybeat-schedule*
celerybeat.pid
*.pid

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
*.tsbuildinfo
/apps/frontend/coverage/
/coverage/

# ---------------------------------------------------------------------------
# End-to-end test output (Playwright)
# ---------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Logs and local data
# ---------------------------------------------------------------------------
*.log
/logs/
*.sqlite3
*.rdb
*.aof

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.idea/

# VS Code: share project configuration, ignore everything else
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.history/

*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
