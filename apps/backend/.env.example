# AEGIS backend configuration.
#
# Copy to .env for local development. .env is gitignored and must never be
# committed. In deployments, set these as environment variables instead.
# Without configuration the backend runs as production with debug off and
# API documentation disabled.

# development | test | production
AEGIS_ENVIRONMENT=development

# Framework debug mode. Rejected when AEGIS_ENVIRONMENT=production.
# When enabled, unexpected errors return tracebacks to the client.
AEGIS_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
AEGIS_LOG_LEVEL=INFO

# json (structured, for log collection) | text (readable, for local use)
AEGIS_LOG_FORMAT=text

# Serve Swagger UI at /api/docs and the schema at /api/openapi.json, to signed-in
# instance administrators only (never public; DECISIONS.md D-069).
# Leave unset for the default: enabled outside production, disabled in production.
# AEGIS_API_DOCS_ENABLED=true

# Largest accepted request body, in bytes (default 1048576 = 1 MiB).
# AEGIS_MAX_REQUEST_BODY_BYTES=1048576

# --- Authentication (DECISIONS.md D-061 to D-068) ----------------------------
# Server secret for CSRF tokens and rate-limit key names: at least 32 random
# characters, for example from: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in production. Outside production, a temporary key is generated at
# start-up when unset (CSRF tokens then stop working after a restart).
# AEGIS_SECRET_KEY=
# Browser origins allowed to send state-changing requests, comma-separated.
# The API's own origin (from the Host header) is always allowed.
# AEGIS_ALLOWED_ORIGINS=http://localhost:5173
# Secure cookies with the __Host- prefix. Must stay true in production.
# Browsers accept Secure cookies from http://localhost and http://127.0.0.1.
# AEGIS_COOKIE_SECURE=true
# Sessions end after this much inactivity, and after the absolute lifetime.
# AEGIS_SESSION_IDLE_TIMEOUT_MINUTES=60
# AEGIS_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# How long a browser that signed in with the password skips the per-account sign-in
# delay (a trusted-device cookie, D-070). At most 30; sign-out does not end it.
# AEGIS_DEVICE_TRUST_DAYS=30
# Lifetime of password reset tokens issued by an administrator.
# AEGIS_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Argon2id hashes computed at the same time (64 MiB each).
# AEGIS_PASSWORD_HASH_CONCURRENCY=4
# Rate limiting (requires Valkey; refused with 503 when Valkey is unavailable).
# AEGIS_RATE_LIMIT_WINDOW_SECONDS=900
# AEGIS_LOGIN_IP_MAX_FAILURES=30
# AEGIS_LOGIN_PAIR_FREE_FAILURES=5
# AEGIS_LOGIN_ACCOUNT_THROTTLE_FAILURES=20
# AEGIS_LOGIN_ACCOUNT_DELAY_SECONDS=10
# AEGIS_REGISTRATION_IP_MAX_ATTEMPTS=5
# AEGIS_PASSWORD_RESET_IP_MAX_ATTEMPTS=10

# --- PostgreSQL --------------------------------------------------------------
# Leave AEGIS_DATABASE_HOST unset to run without a database (database-backed
# endpoints then return 503). The connection URL is built from these values;
# never configure or log it as a single string.
AEGIS_DATABASE_HOST=localhost
AEGIS_DATABASE_PORT=5432
AEGIS_DATABASE_NAME=aegis
AEGIS_DATABASE_USER=aegis
# No default. Required when AEGIS_ENVIRONMENT=production.
AEGIS_DATABASE_PASSWORD=
# disable | prefer | require | verify-ca | verify-full
# Use verify-full when the database is reached over an untrusted network.
AEGIS_DATABASE_SSLMODE=prefer
# Seconds to wait for a new connection.
# AEGIS_DATABASE_CONNECT_TIMEOUT=5
# Connection pool: persistent connections, extra connections under load,
# seconds to wait for a free connection, seconds before a connection is replaced.
# AEGIS_DATABASE_POOL_SIZE=5
# AEGIS_DATABASE_MAX_OVERFLOW=10
# AEGIS_DATABASE_POOL_TIMEOUT=30
# AEGIS_DATABASE_POOL_RECYCLE=1800

# --- Valkey (message broker) ----------------------------------------------------
# Leave AEGIS_VALKEY_HOST unset to run without a broker (readiness then reports
# the broker as unavailable). Each process connects as its own ACL user; in
# Docker Compose these are aegis-api, worker-internal and worker-assessment.
# AEGIS_VALKEY_HOST=localhost
# AEGIS_VALKEY_PORT=6379
# AEGIS_VALKEY_DB=0
# AEGIS_VALKEY_USERNAME=aegis-api
# No default. Username and password are required when AEGIS_ENVIRONMENT=production.
# AEGIS_VALKEY_PASSWORD=
# Use TLS (rediss://) when Valkey is reached over an untrusted network.
# AEGIS_VALKEY_TLS=false
# AEGIS_VALKEY_CONNECT_TIMEOUT=3
# AEGIS_VALKEY_SOCKET_TIMEOUT=5

# --- Health checks and workers ------------------------------------------------
# Seconds each readiness check (database, broker) may take.
# AEGIS_HEALTH_CHECK_TIMEOUT=2
# Celery soft and hard time limits per task, in seconds.
# AEGIS_WORKER_TASK_SOFT_TIME_LIMIT=300
# AEGIS_WORKER_TASK_TIME_LIMIT=360

# --- Secret files ----------------------------------------------------------------
# Directory of secret files (Docker secrets). A file named after a variable in
# lower case, for example aegis_database_password, supplies its value.
# Environment variables take precedence. Docker Compose sets /run/secrets.
# AEGIS_SECRETS_DIR=

# --- Tests only ----------------------------------------------------------------
# Directory with PostgreSQL's initdb and pg_ctl, if they are not on PATH or in
# the standard Windows location. Tests create their own throwaway cluster.
# AEGIS_TEST_POSTGRES_BIN=
# Set to 1 to fail, instead of skip, the database tests when PostgreSQL is
# not found (CI sets this).
# AEGIS_TEST_REQUIRE_POSTGRES=1
