# Docker Compose settings for AEGIS (docker-compose.yml).
#
# Optional: copy to .env in the repository root to change these defaults.
# .env is gitignored. This file contains no secrets: passwords and the API's
# secret key are files in ./secrets, created by
# "python infrastructure/scripts/init_dev_secrets.py".
#
# The backend's own settings (AEGIS_ENVIRONMENT, AEGIS_DATABASE_*,
# AEGIS_VALKEY_* and others) are set per service in docker-compose.yml. To run
# the backend outside Docker, use apps/backend/.env.example instead.

# Host port of the frontend (published on 127.0.0.1 only).
AEGIS_HTTP_PORT=8080

# Host port of the API in the development override (127.0.0.1 only).
AEGIS_API_PORT=8000

# Browser origins (scheme://host:port) allowed to send state-changing API
# requests, comma-separated. Defaults to http://127.0.0.1:<AEGIS_HTTP_PORT>
# and http://localhost:<AEGIS_HTTP_PORT>. Set it when users reach AEGIS under
# another address, for example through a TLS reverse proxy.
# AEGIS_ALLOWED_ORIGINS=https://aegis.example.org

# First two octets of the five AEGIS networks (edge .0, data .1, queue .2,
# ingest .3, egress .4, each a /24). Change if they overlap with networks you use.
AEGIS_SUBNET_PREFIX=10.213

# Directory holding the secret files.
AEGIS_SECRETS_DIR=./secrets

# Application log level: DEBUG | INFO | WARNING | ERROR
AEGIS_LOG_LEVEL=INFO

# Concurrent tasks per worker container.
AEGIS_WORKER_INTERNAL_CONCURRENCY=2
AEGIS_WORKER_ASSESSMENT_CONCURRENCY=2
